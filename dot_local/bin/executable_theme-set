#!/usr/bin/env bash
set -euo pipefail

config_dir="${XDG_CONFIG_HOME:-$HOME/.config}"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles-theme"
themes_dir="$config_dir/theme/themes"
profile="$config_dir/theme/profile.conf"

test -r "$profile" || {
    printf 'theme-set: missing %s; run chezmoi apply\n' "$profile" >&2
    exit 1
}
source "$profile"
case "${theme_role:-}" in
    private|work) ;;
    *) printf 'theme-set: invalid theme role in %s\n' "$profile" >&2; exit 1 ;;
esac

list_themes() {
    find "$themes_dir" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort
}

choose_theme() {
    command -v fzf >/dev/null 2>&1 || {
        printf 'theme-set: fzf is required for the interactive picker\n' >&2
        return 1
    }
    list_themes | fzf --prompt='Theme > ' --reverse --height='~100%'
}

hex() {
    printf '%s' "${1#\#}"
}

# Alpha-blend $2 (top) over $1 (base) at alpha $3 (0-1), both #rrggbb, no '#' output.
blend() {
    local base_hex top_hex alpha
    base_hex="$(hex "$1")"
    top_hex="$(hex "$2")"
    alpha="$3"
    awk -v b="$base_hex" -v t="$top_hex" -v a="$alpha" 'BEGIN {
        for (i = 0; i < 3; i++) {
            bb = strtonum("0x" substr(b, i * 2 + 1, 2))
            tt = strtonum("0x" substr(t, i * 2 + 1, 2))
            printf "%02x", int(tt * a + bb * (1 - a) + 0.5)
        }
    }'
}

render() {
    local output="$1"
    local elev1_alpha='Config.elev1Alpha'
    local elev2_alpha='Config.elev2Alpha'
    local hyprlock_elev2_alpha='0.07'
    if [[ "$oled" == true ]]; then
        elev1_alpha='0.07'
        elev2_alpha='0.10'
        hyprlock_elev2_alpha='0.10'
    fi
    mkdir -p "$output/quickshell"

    cat > "$output/kitty.conf" <<EOF
background $base
foreground $text
selection_background $highlightMed
selection_foreground $text
cursor $text
cursor_text_color $base
url_color $magenta
active_border_color $blue
inactive_border_color $highlightMed
tab_bar_background $base
active_tab_background $base
active_tab_foreground ${!preferred_accent}
inactive_tab_background $base
inactive_tab_foreground $muted
# ANSI is an upstream terminal palette, deliberately separate from the UI
# palette above.  In particular, a theme's UI "orange" is not necessarily
# ANSI cyan, and several upstream themes define distinct bright colours.
color0 $ansi_0
color1 $ansi_1
color2 $ansi_2
color3 $ansi_3
color4 $ansi_4
color5 $ansi_5
color6 $ansi_6
color7 $ansi_7
color8 $ansi_8
color9 $ansi_9
color10 $ansi_10
color11 $ansi_11
color12 $ansi_12
color13 $ansi_13
color14 $ansi_14
color15 $ansi_15
EOF

    cat > "$output/fuzzel.ini" <<EOF
[colors]
background=${base}ff
text=${text}ff
prompt=${text}ff
placeholder=${muted}ff
input=${text}ff
match=${ui_match}ff
selection=${ui_selection}ff
selection-text=${ui_selection_text}ff
selection-match=${ui_match}ff
counter=${ui_warning}ff
border=${ui_accent}ff
EOF

    cat > "$output/hypr.lua" <<EOF
return {
    base = 0xff$(hex "$base"), surface = 0xff$(hex "$surface"), overlay = 0xff$(hex "$overlay"),
    muted = 0xff$(hex "$muted"), subtle = 0xff$(hex "$subtle"), text = 0xff$(hex "$text"),
    red = 0xff$(hex "$red"), yellow = 0xff$(hex "$yellow"), orange = 0xff$(hex "$orange"),
    blue = 0xff$(hex "$blue"), cyan = 0xff$(hex "$cyan"), magenta = 0xff$(hex "$magenta"),
    highlightLow = 0xff$(hex "$highlightLow"), highlightMed = 0xff$(hex "$highlightMed"), highlightHigh = 0xff$(hex "$highlightHigh"),
}
EOF

    local elev2_hex edge_hex edge_strong_hex
    elev2_hex="$(blend "$base" "$text" "$hyprlock_elev2_alpha")"
    edge_hex="$(blend "$base" "$text" 0.18)"
    # The input field's border sits on the scrim-darkened wallpaper behind
    # it, not on bare base — same under-specified-contrast issue as `edge`
    # on a card in the shell (see the toast-action-button patch), so it
    # wants the same edgeStrong ink.
    edge_strong_hex="$(blend "$base" "$text" 0.28)"

    cat > "$output/hyprlock.conf" <<EOF
\$base = 0xff$(hex "$base")
\$surface = 0xff$(hex "$surface")
\$overlay = 0xff$(hex "$overlay")
\$text = 0xff$(hex "$text")
\$red = 0xff$(hex "$red")
\$yellow = 0xff$(hex "$yellow")
\$accent = 0xff$(hex "${!preferred_accent}")
\$elev2 = rgba(${elev2_hex}ff)
\$edge = rgba(${edge_hex}ff)
\$edgeStrong = rgba(${edge_strong_hex}ff)
\$scrim = rgba(00000080)
EOF

    cat > "$output/fish.fish" <<EOF
set -g fish_color_normal $(hex "$text")
set -g fish_color_command $(hex "$magenta")
set -g fish_color_keyword $(hex "$cyan")
set -g fish_color_quote $(hex "$yellow")
set -g fish_color_redirection $(hex "$blue")
set -g fish_color_end $(hex "$subtle")
set -g fish_color_error $(hex "$ui_error")
set -g fish_color_param $(hex "$orange")
set -g fish_color_comment $(hex "$muted")
set -g fish_color_selection --background=$(hex "$ui_selection")
set -g fish_color_autosuggestion $(hex "$muted")
set -g fish_pager_color_background --background=$(hex "$surface")
set -g fish_pager_color_prefix $(hex "$cyan")
set -g fish_pager_color_completion $(hex "$subtle")
set -g fish_pager_color_selected_background --background=$(hex "$ui_selection")
set -g fish_pager_color_selected_completion $(hex "$ui_selection_text")
set -gx LS_COLORS 'di=38;2;$(rgb "$blue"):ln=38;2;$(rgb "$cyan"):ex=38;2;$(rgb "$magenta"):*.tar=38;2;$(rgb "$yellow"):*.zip=38;2;$(rgb "$yellow"):*.jpg=38;2;$(rgb "$orange"):*.png=38;2;$(rgb "$orange")'

EOF

    cat > "$output/fzf.fish" <<EOF
set -gx FZF_DEFAULT_OPTS '--color=fg:$subtle,bg:$base,hl:$ui_match --color=fg+:$text,bg+:$ui_selection,hl+:$ui_match --color=border:$ui_accent,header:$ui_link,gutter:$base --color=spinner:$ui_warning,info:$ui_info,separator:$ui_selection --color=pointer:$magenta,marker:$ui_error,prompt:$subtle'
EOF

    printf 'palette = "active"\n\n' > "$output/starship.toml"
    cat "$config_dir/theme/starship.toml" >> "$output/starship.toml"
    cat >> "$output/starship.toml" <<EOF


[palettes.active]
base = "$base"
surface = "$surface"
overlay = "$overlay"
muted = "$muted"
subtle = "$subtle"
text = "$text"
red = "$red"
yellow = "$yellow"
orange = "$orange"
blue = "$blue"
cyan = "$cyan"
magenta = "$magenta"
accent = "$ui_accent"
match = "$ui_match"
link = "$ui_link"
success = "$ui_success"
warning = "$ui_warning"
error = "$ui_error"
info = "$ui_info"
EOF

    cat > "$output/delta.gitconfig" <<EOF
[delta]
    dark = true
    file-style = "$text" bold
    file-decoration-style = "$highlightMed" ul
    hunk-header-decoration-style = "$highlightMed" box ul
    hunk-header-file-style = "$ui_info" bold
    hunk-header-line-number-style = "$ui_match" bold
    line-numbers-left-style = "$muted"
    line-numbers-right-style = "$muted"
    line-numbers-minus-style = "$ui_git_delete"
    line-numbers-plus-style = "$ui_git_add"
    line-numbers-zero-style = "$muted"
    minus-style = syntax "$ui_git_delete"
    minus-emph-style = syntax "$ui_error"
    plus-style = syntax "$ui_git_add"
    plus-emph-style = syntax "$ui_success"
    zero-style = syntax
    whitespace-error-style = "$ui_warning" reverse
    blame-palette = "$base" "$surface" "$overlay" "$highlightMed"
EOF

    printf '%s\n' '--theme=ansi' > "$output/bat.conf"
    cat > "$output/eza.yml" <<EOF
colourful: true
filekinds:
  normal: {foreground: "$text"}
  directory: {foreground: "$ui_info"}
  symlink: {foreground: "$ui_link"}
  executable: {foreground: "$magenta"}
  pipe: {foreground: "$yellow"}
  socket: {foreground: "$orange"}
  block_device: {foreground: "$orange"}
  char_device: {foreground: "$yellow"}
  special: {foreground: "$magenta"}
  mount_point: {foreground: "$ui_link"}
perms:
  user_read: {foreground: "$subtle"}
  user_write: {foreground: "$yellow"}
  user_execute_file: {foreground: "$magenta"}
  user_execute_other: {foreground: "$magenta"}
  group_read: {foreground: "$subtle"}
  group_write: {foreground: "$yellow"}
  group_execute: {foreground: "$magenta"}
  other_read: {foreground: "$subtle"}
  other_write: {foreground: "$yellow"}
  other_execute: {foreground: "$magenta"}
  special_user_file: {foreground: "$magenta"}
  special_other: {foreground: "$yellow"}
  attribute: {foreground: "$subtle"}
size:
  major: {foreground: "$subtle"}
  minor: {foreground: "$ui_info"}
  number_byte: {foreground: "$subtle"}
  number_kilo: {foreground: "$blue"}
  number_mega: {foreground: "$blue"}
  number_giga: {foreground: "$magenta"}
  number_huge: {foreground: "$magenta"}
  unit_byte: {foreground: "$subtle"}
  unit_kilo: {foreground: "$blue"}
  unit_mega: {foreground: "$magenta"}
  unit_giga: {foreground: "$magenta"}
  unit_huge: {foreground: "$ui_info"}
users:
  user_you: {foreground: "$yellow"}
  user_root: {foreground: "$red"}
  user_other: {foreground: "$magenta"}
  group_yours: {foreground: "$blue"}
  group_other: {foreground: "$muted"}
  group_root: {foreground: "$red"}
links:
  normal: {foreground: "$ui_link"}
  multi_link_file: {foreground: "$blue"}
git:
  new: {foreground: "$ui_git_add"}
  modified: {foreground: "$ui_git_change"}
  deleted: {foreground: "$ui_git_delete"}
  renamed: {foreground: "$magenta"}
  ignored: {foreground: "$muted"}
  typechange: {foreground: "$magenta"}
  conflicted: {foreground: "$ui_warning"}
git_repo:
  branch_main: {foreground: "$subtle"}
  branch_other: {foreground: "$magenta"}
  git_clean: {foreground: "$ui_git_add"}
  git_dirty: {foreground: "$ui_error"}
security_context:
  colon: {foreground: "$subtle"}
  user: {foreground: "$ui_info"}
  role: {foreground: "$magenta"}
  typ: {foreground: "$muted"}
  range: {foreground: "$magenta"}
file_type:
  image: {foreground: "$yellow"}
  video: {foreground: "$red"}
  music: {foreground: "$ui_info"}
  lossless: {foreground: "$muted"}
  crypto: {foreground: "$ui_info"}
  document: {foreground: "$subtle"}
  compressed: {foreground: "$magenta"}
  temp: {foreground: "$orange"}
  compiled: {foreground: "$blue"}
  build: {foreground: "$muted"}
  source: {foreground: "$orange"}
punctuation: {foreground: "$subtle"}
date: {foreground: "$blue"}
inode: {foreground: "$subtle"}
blocks: {foreground: "$muted"}
header: {foreground: "$subtle"}
  octal: {foreground: "$ui_info"}
flags: {foreground: "$magenta"}
  symlink_path: {foreground: "$ui_link"}
control_char: {foreground: "$blue"}
broken_symlink: {foreground: "$red"}
broken_path_overlay: {foreground: "$red"}
EOF
    printf 'return { colorscheme = "%s", oled = %s, surface = "%s", overlay = "%s", highlight_low = "%s", highlight_med = "%s" }\n' \
        "$nvim_colorscheme" "$oled" "$surface" "$overlay" "$highlightLow" "$highlightMed" > "$output/nvim.lua"

    cat > "$output/quickshell/Theme.qml" <<EOF
pragma Singleton
import Quickshell
import QtQuick

Singleton {
    readonly property color base: "$base"
    readonly property color surface: "$surface"
    readonly property color overlay: "$overlay"
    readonly property color muted: "$muted"
    readonly property color subtle: "$subtle"
    readonly property color text: "$text"
    readonly property color red: "$red"
    readonly property color redDim: "$redDim"
    readonly property color yellow: "$yellow"
    readonly property color yellowDim: "$yellowDim"
    readonly property color orange: "$orange"
    readonly property color orangeDim: "$orangeDim"
    readonly property color blue: "$blue"
    readonly property color blueDim: "$blueDim"
    readonly property color cyan: "$cyan"
    readonly property color cyanDim: "$cyanDim"
    readonly property color magenta: "$magenta"
    readonly property color semanticAccent: "$ui_accent"
    readonly property color semanticAccentDim: "$ui_accent_dim"
    readonly property color selection: "$ui_selection"
    readonly property color selectionText: "$ui_selection_text"
    readonly property color match: "$ui_match"
    readonly property color link: "$ui_link"
    readonly property color success: "$ui_success"
    readonly property color warning: "$ui_warning"
    readonly property color error: "$ui_error"
    readonly property color info: "$ui_info"
    readonly property color gitAdd: "$ui_git_add"
    readonly property color gitChange: "$ui_git_change"
    readonly property color gitDelete: "$ui_git_delete"
    readonly property color magentaDim: "$magentaDim"
    readonly property var _accentMap: ({ red: red, yellow: yellow, orange: orange, blue: blue, cyan: cyan, magenta: magenta })
    readonly property var _accentDimMap: ({ red: redDim, yellow: yellowDim, orange: orangeDim, blue: blueDim, cyan: cyanDim, magenta: magentaDim })
    readonly property color defaultAccent: semanticAccent
    readonly property color defaultAccentDim: semanticAccentDim
    readonly property color accent: Config.accentColor === "default" ? defaultAccent : (_accentMap[Config.accentColor] ?? defaultAccent)
    readonly property color accentDim: Config.accentColor === "default" ? defaultAccentDim : (_accentDimMap[Config.accentColor] ?? defaultAccentDim)
    readonly property color volumeColor: _accentMap[Config.volumeAccent] ?? magenta
    readonly property color microphoneColor: _accentMap[Config.microphoneAccent] ?? magenta
    readonly property color bluetoothColor: _accentMap[Config.bluetoothAccent] ?? cyan
    readonly property color ethernetColor: _accentMap[Config.ethernetAccent] ?? blue
    readonly property color wirelessColor: _accentMap[Config.wirelessAccent] ?? blue
    readonly property color wireguardColor: _accentMap[Config.wireguardAccent] ?? blue
    readonly property color brightnessColor: _accentMap[Config.brightnessAccent] ?? yellow
    readonly property color notificationColor: _accentMap[Config.notificationAccent] ?? orange
    readonly property color powerColor: _accentMap[Config.powerAccent] ?? red
    readonly property color urgentColor: _accentMap[Config.urgentAccent] ?? red
    readonly property color highlightLow: "$highlightLow"
    readonly property color highlightMed: "$highlightMed"
    readonly property color highlightHigh: "$highlightHigh"

    function _ink(a) { return Qt.rgba(text.r, text.g, text.b, a) }

    // Opaque — composited over the palette's own base.
    readonly property color elev1:   Qt.tint(base, _ink($elev1_alpha))   // bar islands
    readonly property color elev2:   Qt.tint(base, _ink($elev2_alpha))   // popouts, toasts, OSD, menus
    readonly property color edge:    Qt.tint(base, _ink(Config.edgeAlpha))   // the 1px border on everything: islands, popouts, OSDs, toasts (outside is base)
    // edge ink is calibrated against bare base (0 ink). A border that
    // instead sits on an elev1/elev2 card only nets edge-minus-card of
    // contrast (0.18-0.10 = 0.08 against elev2 — half the intended
    // delta, which is why it read as barely-there). edgeStrong restores the
    // same ~0.18 effective delta against a card. Use this for any 1px
    // border whose *outside* is a card, not base: buttons, chips, rows,
    // input fields inside a popout.
    readonly property color edgeStrong: Qt.tint(base, _ink(0.28))
    // An already-elev2 row/card brightening on hover (e.g. a connected
    // device row) needs an opaque result too — animating a Behavior on
    // color from opaque elev2 to translucent press interpolates the alpha
    // channel along with it, so partway through the 80ms transition the row
    // genuinely goes semi-transparent and flickers. Pre-composited here
    // instead of animating into translucency.
    readonly property color elev2Hover: Qt.tint(elev2, _ink(0.16))

    // Translucent — composited over whatever they sit on.
    readonly property color edgeTop: _ink(0.07)   // 1px inner highlight, top edge of popouts
    readonly property color hover:   _ink(0.10)   // hover fill on cells and rows
    readonly property color press:   _ink(0.16)   // press fill
    readonly property color divider: _ink(0.10)   // rules inside popouts, slider tracks

    // Fill for a control that sits *on* a card (buttons, chips), as a
    // recessed → level → raised progression relative to the card's own
    // elev2 ink (0.10) — rest reads as a well, never outranking the card;
    // hover/press are the same values as hover/press above, named
    // separately so callers say what they mean (a control's own fill vs. a
    // hover highlight on an otherwise-bare row).
    readonly property color controlRest:  _ink(0.05)   // below the card — recessed
    readonly property color controlHover: _ink(0.10)   // level with the card
    readonly property color controlPress: _ink(0.16)   // above the card
}
EOF
}

rgb() {
    local value
    value="$(hex "$1")"
    printf '%d;%d;%d' "0x${value:0:2}" "0x${value:2:2}" "0x${value:4:2}"
}

reload_apps() {
    command -v kitty >/dev/null 2>&1 && pkill -USR1 -x kitty >/dev/null 2>&1 || true
    [[ "$theme_role" == private ]] || return 0

    command -v hyprctl >/dev/null 2>&1 && hyprctl reload >/dev/null 2>&1 || true
    pgrep -x quickshell >/dev/null 2>&1 || return 0
    pkill -x quickshell
    for _ in {1..20}; do
        pgrep -x quickshell >/dev/null 2>&1 || break
        sleep 0.1
    done
    command -v quickshell >/dev/null 2>&1 && quickshell --path "$config_dir/quickshell" --daemonize --no-duplicate --no-color
}

update_htop() {
    local htoprc="$config_dir/htop/htoprc"
    test -f "$htoprc" || return 0
    if grep -q '^color_scheme=' "$htoprc"; then
        sed -i "s/^color_scheme=.*/color_scheme=$htop_scheme/" "$htoprc"
    else
        printf '\ncolor_scheme=%s\n' "$htop_scheme" >> "$htoprc"
    fi
}

no_reload=false
case "${1:-}" in
    --list) list_themes; exit 0 ;;
    --no-reload) no_reload=true; shift ;;
    -h|--help) printf 'Usage: theme-set [--list] [--no-reload] [theme]\n'; exit 0 ;;
esac

theme="${1:-}"
if test -z "$theme"; then
    theme="$(choose_theme)" || exit $?
fi
test -n "$theme" || exit 0
case "$theme" in *[!a-z0-9-]*) printf 'theme-set: invalid theme name\n' >&2; exit 1 ;; esac
palette="$themes_dir/$theme/palette.conf"
test -r "$palette" || { printf 'theme-set: unknown theme: %s\n' "$theme" >&2; exit 1; }

source "$palette"
ui_palette="$themes_dir/${theme%-oled}/ui.conf"
test -r "$ui_palette" || { printf 'theme-set: missing UI palette for %s\n' "$theme" >&2; exit 1; }
source "$ui_palette"
ansi_palette="$themes_dir/${theme%-oled}/ansi.conf"
test -r "$ansi_palette" || { printf 'theme-set: missing ANSI palette for %s\n' "$theme" >&2; exit 1; }
source "$ansi_palette"
oled=false
[[ "$theme" == *-oled ]] && oled=true
required=(base surface overlay muted subtle text red redDim yellow yellowDim orange orangeDim blue blueDim cyan cyanDim magenta magentaDim highlightLow highlightMed highlightHigh nvim_colorscheme htop_scheme preferred_accent ui_accent ui_accent_dim ui_selection ui_selection_text ui_match ui_link ui_success ui_warning ui_error ui_info ui_git_add ui_git_change ui_git_delete ansi_0 ansi_1 ansi_2 ansi_3 ansi_4 ansi_5 ansi_6 ansi_7 ansi_8 ansi_9 ansi_10 ansi_11 ansi_12 ansi_13 ansi_14 ansi_15)
for key in "${required[@]}"; do
    test -n "${!key:-}" || { printf 'theme-set: %s is missing %s\n' "$theme" "$key" >&2; exit 1; }
done

ui_roles=(ui_accent ui_accent_dim ui_selection ui_selection_text ui_match ui_link ui_success ui_warning ui_error ui_info ui_git_add ui_git_change ui_git_delete)
for role in "${ui_roles[@]}"; do
    color_name="${!role}"
    color_value="${!color_name:-}"
    [[ "$color_value" =~ ^#[[:xdigit:]]{6}$ ]] || {
        printf 'theme-set: %s has invalid colour reference %s in %s\n' "$role" "$color_name" "$ui_palette" >&2
        exit 1
    }
    printf -v "$role" '%s' "$color_value"
done

mkdir -p "$state_dir"
command -v flock >/dev/null 2>&1 || { printf 'theme-set: flock is required\n' >&2; exit 1; }
exec 9>"$state_dir/.theme-set.lock"
flock -x 9
tmp_dir="$(mktemp -d "$state_dir/.$theme.XXXXXX")"
trap 'rm -rf "$tmp_dir"' EXIT
render "$tmp_dir"
rm -rf "$state_dir/$theme"
mv "$tmp_dir" "$state_dir/$theme"
ln -sfnT "$state_dir/$theme" "$state_dir/current"
trap - EXIT

mkdir -p "$config_dir/bat" "$config_dir/eza"
ln -sfnT "$state_dir/current/bat.conf" "$config_dir/bat/config"
ln -sfnT "$state_dir/current/eza.yml" "$config_dir/eza/theme.yml"
if [[ "$theme_role" == private ]]; then
    mkdir -p "$config_dir/quickshell" "$config_dir/hypr/colors"
    ln -sfnT "$state_dir/current/quickshell/Theme.qml" "$config_dir/quickshell/Theme.qml"
    ln -sfnT "$state_dir/current/hyprlock.conf" "$config_dir/hypr/colors/current.conf"
fi

printf '%s\n' "$theme" > "$state_dir/current.name"
update_htop

if ! "$no_reload"; then reload_apps; fi
printf 'Theme set to %s\n' "$theme"
