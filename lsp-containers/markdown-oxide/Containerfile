# markdown_oxide. Prebuilt release tarball (no upstream checksum;
# MARKDOWN_OXIDE_SHA256 is trust-on-first-use, recorded in versions.env).
# File watching is done by Neovim (client-side), so the container only needs the
# workspace at matching paths.
FROM docker.io/library/debian:trixie-slim AS fetch

RUN --mount=type=secret,id=company_ca,required=false \
    set -e; \
    apt_ca=; \
    if [ -r /run/secrets/company_ca ]; then apt_ca='-o Acquire::https::CaInfo=/run/secrets/company_ca'; fi; \
    apt-get $apt_ca update \
 && apt-get $apt_ca install -y --no-install-recommends curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

ARG MARKDOWN_OXIDE_VERSION
ARG MARKDOWN_OXIDE_SHA256

RUN --mount=type=secret,id=company_ca,required=false \
    set -eux; \
    if [ -r /run/secrets/company_ca ]; then \
      cp /etc/ssl/certs/ca-certificates.crt /tmp/company-ca-bundle; \
      cat /run/secrets/company_ca >> /etc/ssl/certs/ca-certificates.crt; \
    fi; \
    curl -fsSL -o /tmp/mdox.tar.gz \
      "https://github.com/Feel-ix-343/markdown-oxide/releases/download/v${MARKDOWN_OXIDE_VERSION}/markdown-oxide-v${MARKDOWN_OXIDE_VERSION}-x86_64-unknown-linux-gnu.tar.gz"; \
    echo "${MARKDOWN_OXIDE_SHA256}  /tmp/mdox.tar.gz" | sha256sum -c -; \
    tar -xzf /tmp/mdox.tar.gz -C /tmp; \
    install -m 0755 "$(find /tmp -type f -name markdown-oxide | head -n1)" /usr/local/bin/markdown-oxide; \
    if [ -e /tmp/company-ca-bundle ]; then mv /tmp/company-ca-bundle /etc/ssl/certs/ca-certificates.crt; fi

FROM docker.io/library/debian:trixie-slim

COPY --from=fetch /usr/local/bin/markdown-oxide /usr/local/bin/markdown-oxide

ENTRYPOINT ["markdown-oxide"]
