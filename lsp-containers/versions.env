# Single source of truth for WHAT language-server versions we run.
#
# build.sh sources this file and passes each value that a Containerfile declares
# via `ARG` as a --build-arg. Containerfiles describe only HOW to build. To
# update a server: bump the value here and run `./build.sh <name>`.
#
# Integrity model:
#   npm packages   npm verifies the registry sha512 integrity hash for the pinned version
#   go install     the Go module checksum database verifies the sources
#   HashiCorp      *_SHA256 is copied from the signed releases.hashicorp.com SHA256SUMS
#   other binaries upstream publishes no checksums; *_SHA256 is trust-on-first-use,
#                  recorded from the first download. A changed artifact fails the build.

# --- npm (integrity: npm registry sha512) ---
BASH_LANGUAGE_SERVER_VERSION=5.6.0
VSCODE_LANGSERVERS_EXTRACTED_VERSION=4.10.0
TYPESCRIPT_LANGUAGE_SERVER_VERSION=6.0.0
TYPESCRIPT_VERSION=5.9.3
TAILWINDCSS_LANGUAGE_SERVER_VERSION=0.16.0
YAML_LANGUAGE_SERVER_VERSION=1.24.0
BASEDPYRIGHT_VERSION=1.39.10
ANSIBLE_LANGUAGE_SERVER_VERSION=26.6.0

# --- pip (integrity: PyPI wheel hashes) ---
ANSIBLE_CORE_VERSION=2.21.3
ANSIBLE_LINT_VERSION=26.8.0

# --- go install (integrity: Go checksum database) ---
GOPLS_VERSION=0.23.0
DOCKER_LANGUAGE_SERVER_VERSION=0.20.1

# --- HashiCorp (integrity: signed SHA256SUMS) ---
TERRAFORM_LS_VERSION=0.39.0
TERRAFORM_LS_SHA256=7750edc736845fd8c04ff0fc6332423c12d8275b358668c8c17e8aedc43ef971
TERRAFORM_VERSION=1.16.1
TERRAFORM_SHA256=745d33b4b02b7980c62a38ec1beea24ee084ea8caf3f503c200554bd9a0cbe49

# --- GitHub release binaries (integrity: trust-on-first-use SHA256, recorded here) ---
RUST_ANALYZER_VERSION=2026-08-31
RUST_ANALYZER_SHA256=a775f9edb543bb0c077da339b783e89446092986cde921c9d8e1733b091080c6
TEXLAB_VERSION=5.26.0
TEXLAB_SHA256=8697bd5e479d4584b14b7eed5c320c80ec4e1d91ebefbb6801e6bf38e9971300
LUA_LANGUAGE_SERVER_VERSION=3.19.1
LUA_LANGUAGE_SERVER_SHA256=e9235d2d72ef55bc41cf8c99cda2ed64777682024b4bb81f5dea425060c5cbb8
MARKDOWN_OXIDE_VERSION=0.25.12
MARKDOWN_OXIDE_SHA256=ad4248cf5d3f0e9d9f120b579501c45dad9c46bfcb4ddec36d2cb85d68a58828
PHPACTOR_VERSION=2026.06.23.0
PHPACTOR_SHA256=25645647d9aa2dc69536fb4f75c976e33ef1a7b5533534a8456736e5e6fd5079

# --- qmlls: Arch package snapshot the image is frozen to (archive.archlinux.org) ---
# Bump only when the containerised Qt/Quickshell must track a newer host runtime,
# not on every host Qt patch release.
QT_ARCHIVE_SNAPSHOT=2026/09/01
