hl.on("hyprland.start", function()
    -- Daemons / background services
    hl.exec_cmd("hypridle")
    hl.exec_cmd("systemctl --user start hyprpolkitagent")
    hl.exec_cmd("hyprpaper")
    hl.exec_cmd("quickshell")
    hl.exec_cmd("wl-paste --watch cliphist store")

    hl.exec_cmd(terminal, { workspace = "1", float = true, size = {1800, 1300}, center = true })
    hl.exec_cmd(browser,  { workspace = "2" })
    hl.exec_cmd("signal-desktop",  { workspace = "3" })
    hl.exec_cmd("element-desktop", { workspace = "3" })
    hl.exec_cmd(terminal, { workspace = "4", float = true, size = {1800, 1300}, center = true })
    hl.exec_cmd(notesApp)
    hl.exec_cmd("keepassxc", { workspace = "6" })
end)


