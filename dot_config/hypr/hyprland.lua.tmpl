local mainMod = "ALT"
local cmdMod  = "SUPER"

-- Apps
hl.bind(mainMod .. " + SPACE",  hl.dsp.exec_cmd(terminal))
hl.bind(mainMod .. " + RETURN", hl.dsp.exec_cmd(terminal))
hl.bind(cmdMod  .. " + SPACE",  hl.dsp.exec_cmd(menu))

-- Window/session
hl.bind(cmdMod  .. " + Q",         hl.dsp.window.close())
hl.bind(mainMod .. " + SHIFT + Q", hl.dsp.exit())

-- Reload Hyprland and Quickshell
hl.bind(mainMod .. " + R",         hl.dsp.exec_cmd("hyprctl reload"))
hl.bind(mainMod .. " + SHIFT + R", hl.dsp.exec_cmd("pkill quickshell; hyprctl dispatch 'hl.dsp.exec_cmd(\"quickshell\")'"))

-- Switch display output (locked = works while session is locked)
hl.bind(cmdMod .. " + D", hl.dsp.exec_cmd(displayoutput), { locked = true })

-- Lock session
hl.bind(cmdMod .. " + L", hl.dsp.exec_cmd("loginctl lock-session"))

-- Active window geometry as a slurp-compatible string.
local activeWindowGeom = [[$(hyprctl -j activewindow | jq -r '"\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"')]]

-- Screenshot: pass nil for full screen, "$(slurp)" for region, activeWindowGeom for active window.
local function screenshot(region)
    local path = screenshots_dir .. '/$(date +"%Y-%m-%dT%H:%M:%S.%3N.png")'
    local geom = region and ('-g "' .. region .. '" ') or ""
    return hl.dsp.exec_cmd(
        "grim " .. geom .. path ..
        ' && notify-send --icon=camera-photo "Screenshot saved" "Saved to ' .. screenshots_dir .. '"'
    )
end

-- Screenrecord: same region semantics. Toggles — SIGINT stops a running wl-screenrec (saving it),
-- otherwise starts a new recording.
local function screenrecord(region)
    local path = screenrecordings_dir .. '/$(date +"%Y-%m-%dT%H:%M:%S.%3N.mp4")'
    local geom = region and ('-g "' .. region .. '" ') or ""
    return hl.dsp.exec_cmd(
        '(pkill -SIGINT wf-recorder && notify-send --icon=camera-video "Screenrecording saved" "Saved to '
        .. screenrecordings_dir .. '") || wf-recorder ' .. geom .. '-f ' .. path
    )
end

-- Screenshots
hl.bind(cmdMod  .. " + SHIFT + 3",                    screenshot())
hl.bind(cmdMod  .. " + SHIFT + 4",                    screenshot("$(slurp)"))
hl.bind(mainMod .. " + " .. cmdMod .. " + SHIFT + 4", screenshot(activeWindowGeom))

-- Screenrecordings
hl.bind(cmdMod  .. " + SHIFT + 5",                    screenrecord())
hl.bind(cmdMod  .. " + SHIFT + 6",                    screenrecord("$(slurp)"))
hl.bind(mainMod .. " + " .. cmdMod .. " + SHIFT + 6", screenrecord(activeWindowGeom))

-- Autio recording for text to speech
