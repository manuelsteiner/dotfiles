---- WINDOWS AND WORKSPACES ----
--------------------------------

-- Ignore maximize requests from apps
hl.window_rule({
    name            = "windowrule-1",
    match           = { class = ".*" },
    suppress_event  = "maximize",
})

-- Fix some dragging issues with XWayland
hl.window_rule({
    name  = "windowrule-2",
    match = {
        class      = "^$",
        title      = "^$",
        xwayland   = true,
        float      = true,
        fullscreen = false,
        pin        = false,
    },
    no_focus = true,
})

-- Automatically send Obsidian to special workspace
hl.window_rule({
    name      = "windowrule-3",
    match     = { title = "^(.*Obsidian.*)$" },
    workspace = "special",
})
