source=~/.config/hypr/colors/current.conf

$background = {{ .chezmoi.homeDir }}/Pictures/wallpaper.png

# BACKGROUND
background {
    monitor =
    color = $base
    path = $background
}

# SCRIM — flat 50% black overlay instead of blur/brightness/contrast/vibrancy.
# Blurring a dark wallpaper leaves it dark, and brightness < 1.0 darkens it
# further; a flat scrim works on any wallpaper. Hyprlock's shape widget takes
# plain pixel sizes (no percentage support), so this is oversized well past
# any real monitor resolution and pinned to the top-left corner to guarantee
# full coverage regardless of the wallpaper/output size.
shape {
    monitor =
    size = 7680, 4320
    color = $scrim
    rounding = 0
    border_size = 0
    position = 0, 0
    halign = left
    valign = top
}

# GENERAL
general {
    no_fade_in = false
    grace = 0
    disable_loading_bar = false
}

# TIME
label {
    monitor =
    text = cmd[update:1000] echo "$(date +"%H:%M")"
    color = $text
    font_size = 120
    font_family = Noto Bold
    position = 0, -140
    halign = center
    valign = top
}

# DAY-DATE-MONTH
label {
    monitor =
    text = cmd[update:1000] echo "<span>$(date '+%A, %d %B')</span>"
    color = $text
    font_size = 30
    font_family = Noto Bold
    position = 0, -320
    halign = center
    valign = top
}

# USER
label {
    monitor =
    text = $USER
    color = $text
    font_size = 25
    font_family = Noto Bold
    position = 0, -70
    halign = center
    valign = center
}

# INPUT FIELD
input-field {
    monitor =
    size = 290, 60
    outline_thickness = 1
    rounding = 10
    dots_size = 0.2 # Scale of input-field height, 0.2 - 0.8
    dots_spacing = 0.2 # Scale of dots' absolute size, 0.0 - 1.0
    dots_center = true
    outer_color = $edge
    inner_color = $elev2
    font_color = $text
    fade_on_empty = false
    font_family = Noto Bold
    placeholder_text = Enter Password
    check_color = $yellow
    fail_color = $red
    fail_text = $FAIL <b>($ATTEMPTS)</b>
    hide_input = false
    position = 0, -140
    halign = center
    valign = center
}
